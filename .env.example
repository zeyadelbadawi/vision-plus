# Build-time (non-secret). See docs/MASTER_PROJECT_PLAN.md §43.
# preview = placeholders and draft translations visible (noindex); production = strict gates.
CONTENT_MODE=preview
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Worker runtime (not read from this file): SITE_ENV is set per environment in wrangler.jsonc
# ("preview" on vision-plus-web-preview, "production" on vision-plus-web).

# Deployment only — never commit real values. Set them as GitHub repository secrets
# (Settings → Secrets and variables → Actions) or export them in your shell for a manual deploy.
# They come from the client's Cloudflare account (D-22). See docs/DEPLOYMENT.md.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
