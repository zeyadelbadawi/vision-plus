{
  "name": "vision-plus-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/content-check.mjs && node scripts/assets-check.mjs && node scripts/images.mjs && node scripts/fonts.mjs && node scripts/og.mjs && next build && node scripts/postbuild.mjs",
    "serve": "node scripts/serve-static.mjs",
    "lint": "eslint . && node scripts/brand-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "node scripts/visual.mjs",
    "test:visual:update": "node scripts/visual.mjs --update-snapshots",
    "canva:parse": "node scripts/canva-parse.mjs",
    "content:check": "node scripts/content-check.mjs",
    "content:fidelity": "node scripts/content-fidelity.mjs",
    "i18n:export": "node scripts/i18n-export.mjs",
    "assets:check": "node scripts/assets-check.mjs",
    "images": "node scripts/images.mjs",
    "og": "node scripts/og.mjs",
    "manifest:sync": "node scripts/sync-image-manifest.mjs",
    "worker:dev": "wrangler dev --local --port 8787",
    "worker:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run && wrangler deploy --dry-run --env production --outdir .wrangler/dry-run-production",
    "worker:smoke": "node scripts/worker-smoke.mjs",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "deploy:production": "wrangler deploy --env production",
    "budget": "node scripts/budget.mjs",
    "site:check": "node scripts/site-check.mjs",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.1.1",
    "postcss": "^8.5.28",
    "prettier": "3.9.9",
    "sharp": "^0.35.4",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "wrangler": "^4.145.0",
    "write-excel-file": "4.1.1",
    "zod": "4.6.5"
  }
}
